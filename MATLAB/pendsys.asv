function params = pendsys(params)
    arguments
        params = struct();
    end

    % constants
    params.g = -9.81; % gravitational acceleration (m/s^2)
    params.L = 2.0;  % length of the pendulum (m) length of paint stick is 30.79cm
    params.m = .011;  % mass of the pendulum (kg) Mass of pendulum W/o drill holl is 11g. remeasure w/ drill hole
    params.M = 5.0; % mass of the cart (kg) Mass of cart, dowel, encoder, screws, and nuts: 0.052kg
    params.W = 5;  % cart width (m)
    params.H = .5; % cart height (m)
    params.wr = .4; % wheel radius
    params.mr = .7; % mass radius
    params.d = 1;
    params.b = 0.02;        % pendulum pivot/bearing friction (N*m*s/rad)
    params.cd_cart = 0.05;  % cart aerodynamic drag coeff, quadratic in v (N*s^2/m^2)
    params.cd_pend = 0.005;  % pendulum aerodynamic drag coeff, quadratic in w (N*m*s^2/rad^2)
end
